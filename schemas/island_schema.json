{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "卜卜岛 PONYO · 岛镜最小字段校验",
  "description": "每面岛镜的输入最小集 + 输出结构。前端/工作流据此校验。",
  "type": "object",
  "required": ["mirror", "input", "output"],
  "properties": {
    "mirror": {
      "type": "string",
      "enum": [
        "01_guihuo","02_qixiang","03_tongqian","04_leida","05_xingxiu",
        "06_jiashicang","07_honglvdeng","08_juchang","09_sanyuanse",
        "10_beiou","11_chenjian","12_cike","13_shuzi","14_dushiju",
        "15_beidi","16_zhongbai","17_caizi","18_yehang"
      ],
      "description": "岛镜唯一标识"
    },
    "input": {
      "type": "object",
      "description": "各镜最小输入集，缺项时只问最小集，不脑补",
      "properties": {
        "question":    { "type": "string", "description": "所问之事（越具体越好）" },
        "datetime":    { "type": "string", "description": "公历出生/问事时间，含时分" },
        "city":        { "type": "string", "description": "出生城市，用于真太阳时" },
        "gender":      { "type": "string", "enum": ["男","女"] },
        "symbol":      { "type": "string", "description": "数字/字/渣形/梦境等取象" },
        "preferences": { "type": "object", "description": "牌阵/抽数/落宫等偏好" }
      }
    },
    "output": {
      "type": "object",
      "required": ["tier", "content", "disclaimer"],
      "properties": {
        "tier": {
          "type": "string",
          "enum": ["light", "pro"],
          "description": "light=轻量轨(默认) / pro=专业轨(用户要求展开)"
        },
        "content": {
          "type": "object",
          "required": ["tendency","image","action","question"],
          "properties": {
            "tendency": { "type": "string", "description": "一句倾向，不铁口" },
            "image":    { "type": "string", "description": "一个意象/画面" },
            "action":   { "type": "string", "description": "今天能做的微小动作" },
            "question": { "type": "string", "description": "把决定权交回的反问" }
          }
        },
        "disclaimer": {
          "type": "string",
          "const": "🫧 卜卜岛 PONYO 小贴士：本内容由 AI 生成，属传统文化与心理投射式参考，非人类占卜师、非科学预测、不承诺改运。名字好听，决定你自己做。"
        },
        "simulated_note": {
          "type": "string",
          "description": "若涉及模拟取象(铜钱/塔罗/卢恩/灵摆/咖啡渣)，必填声明非实物"
        }
      }
    }
  }
}
